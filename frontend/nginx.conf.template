# Rendered by the nginx image at start-up (envsubst): ${UI_API_KEY} is injected server-side so the
# API key never ships in the browser bundle. The dashboard itself is protected with HTTP basic auth;
# put it behind SSO / a VPN for real deployments.
limit_req_zone $binary_remote_addr zone=ui:10m rate=20r/s;

server {
  listen 8080;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;

  auth_basic "AgentShield";
  auth_basic_user_file /etc/nginx/htpasswd;

  location /api/ {
    proxy_pass http://api:8000;
    proxy_set_header Host $host;
    proxy_set_header X-API-Key "${UI_API_KEY}";
    client_max_body_size 1m;
    limit_req zone=ui burst=40 nodelay;
    proxy_set_header X-Forwarded-For $remote_addr;
  }
  location / {
    try_files $uri /index.html;
  }

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy no-referrer always;
  add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'" always;
}
