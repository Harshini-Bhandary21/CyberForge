# Copy to .env (never commit it). Read by the backend (from backend/ or the repo root) and by docker compose.

# ── Environment ────────────────────────────────────────────────────────────
# "production" refuses to start without API keys + a real signing secret, hides /docs and the demo.
AGENTSHIELD_ENV=development

# ── Database ───────────────────────────────────────────────────────────────
# PostgreSQL (recommended beyond a demo). Leave empty to use the SQLite file below.
DATABASE_URL=
AGENTSHIELD_DB_PATH=data/agentshield.db
# Used by docker compose's bundled Postgres service
POSTGRES_PASSWORD=

# ── API access control ─────────────────────────────────────────────────────
# {key: role}. Roles: agent (guard API only) · analyst (dashboard) · admin (everything).
# Generate keys with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENTSHIELD_API_KEYS={}
# Key the dashboard's nginx proxy injects (use an analyst key; it never reaches the browser bundle)
UI_API_KEY=
AGENTSHIELD_CORS_ORIGINS=["http://localhost:5173"]
AGENTSHIELD_RATE_LIMIT_PER_MIN=1200
# HMAC secret for agent identity credentials. REQUIRED to change in production.
AGENTSHIELD_AGENT_SIGNING_SECRET=dev-only-change-me
AGENTSHIELD_REQUIRE_AGENT_IDENTITY=false

# ── LLM providers (isolated intent verifier + incident narratives) ─────────
# Tried in this order; the first that answers wins; none configured = offline heuristics.
AGENTSHIELD_USE_LLM=true
AGENTSHIELD_LLM_PROVIDERS=["groq","gemini","anthropic"]
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AGENTSHIELD_GROQ_MODEL=llama-3.3-70b-versatile
AGENTSHIELD_GEMINI_MODEL=gemini-2.5-flash
AGENTSHIELD_JUDGE_MODEL=claude-haiku-5-5

# ── Policy thresholds (INR) ────────────────────────────────────────────────
AGENTSHIELD_APPROVAL_AMOUNT_INR=10000
AGENTSHIELD_BLOCK_AMOUNT_INR=500000
